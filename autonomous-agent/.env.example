# SAOS Autonomous Agent — environment configuration
# Copy to .env and fill in the secrets. NEVER commit the real .env.

# --- Leads (currently unused — leads are read from ../crm/leads-no-website.json) ---
LEADS_CSV_PATH=

# --- OpenRouter (website generation LLM) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- Netlify (declared but deploy is currently local-only) ---
NETLIFY_ACCESS_TOKEN=

# --- Gmail API (outreach + reply polling; run `npm run setup` for OAuth) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Sender identity ---
SENDER_NAME=
SENDER_EMAIL=
SENDER_PHONE=

# --- Limits ---
DAILY_WEBSITE_LIMIT=50
WEBSITES_PER_BATCH=10

# --- CRM ---
# Where generated demo sites are written. Defaults to the repo's own
# crm/agent-drafts folder (the one the CRM serves) — override only if the CRM
# lives elsewhere.
CRM_DRAFTS_PATH=
CRM_DATA_PATH=
CRM_PORT=8080

# --- Dashboard ---
DASHBOARD_PORT=4000

# --- Designer agent (skill-driven website generation) ---
# true = generation is delegated to a headless Claude Code session running DESIGNER_AGENT_SKILL
DESIGNER_AGENT_ENABLED=false
DESIGNER_AGENT_SKILL=ui-ux-pro-max

# --- QA Gate (pre-approval quality checks on generated sites) ---
# true = every generated site passes the 4-layer QA gate before entering the approval queue
QA_ENABLED=false
# Sites scoring below this (0-100), or with any critical issue, fail QA and are regenerated
QA_MIN_SCORE=80
# How many regeneration attempts (with QA feedback) before queueing as qa_failed
QA_MAX_RETRIES=2
# Per-layer timeout for browser/skill runs
QA_TIMEOUT_SECONDS=300
# true = also run the qa-test skill's adversarial "break it" pass (slower, costlier)
QA_ADVERSARY=false
